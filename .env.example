# Demo mode (default: true). Set to false to enable live Stripe checkout.
# Use NEXT_PUBLIC_DEMO for client-side UI; DEMO is also read on the server.
NEXT_PUBLIC_DEMO=true
DEMO=true

# Stripe (required when DEMO=false / NEXT_PUBLIC_DEMO=false)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: canonical site URL for Stripe redirect URLs (falls back to request origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — required to enable accounts, organizations and agent entitlements.
# Find these in your Supabase project: Settings -> API.
# When unset, the app runs in public demo mode (auth disabled).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: passcode for the investor-relations gate (defaults to "demo").
NEXT_PUBLIC_PASSCODE=demo
